# Copy to .env and adjust. .env is git-ignored — never commit real keys.
# The default setup needs NO API keys: prices come from Yahoo Finance (via
# yfinance) and filing-dated fundamentals from SEC EDGAR, both free.

# Price / snapshot provider: "yahoo" (default) or "stooq" (prices only).
DATA_PROVIDER=yahoo

# SEC EDGAR asks automated clients to identify themselves.
# Format: "Project Name your-email@example.com"
SEC_USER_AGENT=

# First date of price history to download.
PRICE_START=2000-01-01

# Annual risk-free rate used in Sharpe ratios (0.02 = 2%).
RISK_FREE_RATE=0.02

# Where downloaded data is cached.
CACHE_DIR=data/cache

# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
